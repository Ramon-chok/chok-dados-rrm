# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CATALOG_URL: Official external catalog URL of the company
VITE_CATALOG_URL="https://catalogo.chokdistribuidora.com.br"

# ---------------------------------------------------------------------------
# Banco histórico + API de importação (server/)
# ---------------------------------------------------------------------------

# DATABASE_URL: string de conexão Postgres (Supabase, Neon ou qualquer
# Postgres compatível). server/db.ts já configura SSL automaticamente —
# NÃO acrescente "?sslmode=require" na URL (causa erro de certificado
# self-signed com o pooler do Supabase). Para Supabase, use a connection
# string da aba "Session pooler" em Project Settings > Database (a conexão
# "Direct connection" costuma não resolver em redes sem IPv6):
# postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=""

# IMPORT_API_KEY: chave compartilhada exigida no header `x-api-key` das
# chamadas a POST /api/imports. Usada tanto pela automação Python quanto pela
# tela de Importação do site. Deixe vazio apenas em desenvolvimento local.
IMPORT_API_KEY=""

# SERVER_PORT: porta do backend (Node legado ou FastAPI em backend/)
# em desenvolvimento local. O Vite faz proxy de /api para esta porta.
SERVER_PORT="8787"

# JWT_SECRET: segredo dos tokens de login do backend Python.
JWT_SECRET="troque-em-producao"

# SEED_PASSWORD: senha inicial dos usuários criados por `python migrate.py`.
SEED_PASSWORD="Chok@2026"

# ATENÇÃO: NÃO crie VITE_IMPORT_API_KEY. Variáveis VITE_* são embutidas no bundle do
# navegador e ficam públicas. A tela de Importação autentica pelo cookie HttpOnly do
# ADMIN logado; IMPORT_API_KEY serve apenas para automações (scripts) via header x-api-key.

# -------------------------
# CORS / Cookie (produção)
# -------------------------
# CORS_ORIGINS: origens permitidas separadas por vírgula (ex: https://app.exemplo.com,https://admin.exemplo.com)
CORS_ORIGINS="http://localhost:3000"
# NÃO use "*" em produção quando for enviar cookies (HttpOnly); especifique origens concretas.

# JWT cookie (HttpOnly) — recomendado para produção (requer HTTPS quando JWT_COOKIE_SECURE=true)
# Nome do cookie que será usado para autenticação HttpOnly
JWT_COOKIE_NAME="chok_auth_token"
# Marcar como Secure em produção (true) — significa que o cookie só será enviado via HTTPS
JWT_COOKIE_SECURE=true
# Marcar HttpOnly (o padrão recomendado)
JWT_COOKIE_HTTP_ONLY=true
# SameSite: Lax geralmente funciona bem em produção; ajuste conforme necessidades
JWT_COOKIE_SAME_SITE="Lax"
# Opcional: defina o domínio do cookie para o domínio da sua aplicação (ex: .exemplo.com)
JWT_COOKIE_DOMAIN=""

# -------------------------
# Segurança (backend Python)
# -------------------------
# ENVIRONMENT=production ativa a validação de startup: recusa JWT_SECRET fraco (<32 chars),
# CORS "*", cookie sem Secure e desliga /docs. Gere o segredo com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT="development"
# Só "true" atrás de proxy/CDN confiável que sobrescreve X-Forwarded-For (senão o rate limit por IP é burlável).
TRUST_PROXY=false
# Limites anti-DoS (por processo)
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_IMPORT_PER_MINUTE=60
# Bloqueio de força bruta por conta: N falhas => bloqueio por X segundos
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
# Node legado: habilita o login STUB (aceita a senha semente). Nunca em produção.
ALLOW_DEV_AUTH=false
